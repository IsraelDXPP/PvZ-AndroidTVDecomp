# Copy to assets/setup.env (or assets/files/setup.env when resources use files/).
# The existing setup.env parser accepts both "set NAME=value" and "NAME=value".
# Renderer: auto, dx11, dx12, gl, vk, metal. Restart after changing it.
set SEXY_VIDEO_DRIVER=auto

# Game language: loads assets/<language>.pak alongside assets/main.pak.
# Default is en_us when omitted. Changing it takes effect after restart.
set LAWN_LANGUAGE=en_us
# set LAWN_LANGUAGE=zh_cn

# Optional GPU validation/profiling. Independent of the C++ build configuration.
set SEXY_BGFX_DEBUG=0
set SEXY_BGFX_PROFILE=0

# Optional SDL gamepad mappings, relative to the asset root or absolute.
# SDL mappings take priority over the generic HID fallback.
# If present, gamecontrollerdb.txt in the asset root is loaded by default.
# set SDL_GAMECONTROLLERCONFIG_FILE=gamecontrollerdb.txt

# Optional startup/frame settings.
set LAWN_NO_INTRO_VIDEO=1
set SEXY_MAX_FPS=60

# Gameplay options. Set to 0 to disable; restart after changing them.
# Auto-collect sun, money and VS brains; cooperative sun keeps manual pickup.
set LAWN_AUTO_COLLECT=1
# Hide the right-side bushes and foreground cover, including roof tree/pole.
set LAWN_HIDE_COVER_LAYER=1
# PC-style low camera for lawn stages; 600-high world view on the 720-high canvas.
# Single-player uses the larger PC seed bank/tools at high-view X positions, top-aligned.
# Seed-ready flashes and tutorial arrows follow the bank. Default is TV view.
set LAWN_LOW_VIEW=0
