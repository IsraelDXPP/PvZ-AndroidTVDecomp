  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <!-- Output goes to the repository's build/ tree, never into the project
         directory. $(SolutionDir) is unreliable here: when building the
         .vcxproj directly MSBuild sets it to the *project* directory (not
         undefined), which silently produced a second, stale LawnTV.exe under
         src/LawnTVDecomp/build/. Anchor on the .slnx instead, which only
         exists at the repository root. -->
    <RepoRoot Condition="Exists('$(MSBuildThisFileDirectory)..\..\LawnTVDecomp.slnx')">$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(SolutionDir)</RepoRoot>
    <OutDir>$(RepoRoot)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RepoRoot)build\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <TargetName>LawnTV</TargetName>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;LAWNTV_DECOMP;NOMINMAX;GLFW_INCLUDE_NONE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..;$(ProjectDir)Runtime;$(ProjectDir)Platform;$(ProjectDir)Platform\GL;$(ProjectDir)Sexy;$(ProjectDir)Game;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ConformanceMode>false</ConformanceMode>
      <!-- EXPERIMENT: stack cookies off.
           The startup crash is STATUS_STACK_BUFFER_OVERRUN raised by __fastfail,
           which bypasses SEH and a VEH, so no handler can report why. The two
           other candidates for that code are already ruled out: an invalid free
           (Runtime/DeleteGuard.cpp printed nothing) and stub-table stack
           imbalance (all 12538 slots were switched to a stub that pops nothing
           and the crash did not move).
           What remains is a genuine /GS stack cookie check failing, i.e. a
           transcribed function overflowing one of its own local buffers. Turning
           the check off is the cheap way to confirm that: if the crash changes
           character or moves, the cookie is the cause and the search narrows to
           functions with local arrays.
           Turn this back on once the question is answered. -->
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <!-- The sources are UTF-8. Without this cl.exe reads them in the system
           ANSI code page (GBK here); a malformed multi-byte sequence in a
           comment then eats the line ending and the NEXT LINE OF CODE is
           absorbed into the comment and silently disappears, surfacing as a
           bogus "undeclared identifier". tools/check1.py passes the same flag
           to the single-file build, so the two agree. -->
      <AdditionalOptions>/bigobj /source-charset:utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Emit a map file. The runtime probes print return-address RVAs, and
           without a map for THIS link there is no way to turn them into symbol
           names, because the only map in the tree belongs to a separately
           linked probe executable whose layout differs. Resolving a fault RVA
           to a function is the step that located every runtime bug found so
           far, so the main link has to produce one too. -->
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <!-- vcpkg provides the GL stack and asset codecs; see vcpkg.json.
           glad supplies the GL entry points, glfw3 the window/context. -->
      <AdditionalDependencies>winmm.lib;ws2_32.lib;xinput.lib;dinput8.lib;dxguid.lib;glad.lib;glfw3dll.lib;opengl32.lib;jpeg.lib;pugixml.lib;OpenAL32.lib;ogg.lib;vorbis.lib;vorbisfile.lib;minizip-ng.lib;openmpt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <!-- Run-time checks off, deliberately.
           /RTC1 was worth having while the startup crash was being chased: it
           named the uninitialised variables (Image::Image's v3, SexyAppBase's
           v7/v8/v31/v33/v34 and the v79..v100 group) and it caught the ESP
           imbalance from the __fastcall arity mismatch that a plain crash would
           have hidden. Those are fixed.
           What remains is a long tail of the same kind of gap, where IDA's own
           decompilation leaves a value untracked and the transcription is
           faithful to that, and each one stops the process before the game can
           reach its title screen.
           Running without the checks lets the port get far enough to be worked
           on, which is the current goal. Turn /RTC1 back on to hunt the next one
           deliberately. -->
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <!-- MultiThreadedDLL, NOT MultiThreadedDebugDLL.
           This must match the CRT that the vcpkg dependencies were built
           against. The x86-windows triplet builds them with the DLL CRT, and
           only the RELEASE flavor is installed: vcpkg_installed\x86-windows has
           lib\ but no debug\lib\, because the packages came from the binary
           cache and that cache holds release only. Building Debug against
           /MDd would link a release-CRT import library into a debug-CRT object
           graph, which gives the process two CRT heaps; that is a memory
           corruption source, and this project is currently chasing one.

           Using the release CRT here keeps Debug and the dependencies on one
           heap, so Debug links and runs. The cost is that the debug CRT's own
           checks (leak reporting, the 0xCD fill pattern) are not active in this
           configuration. If those are wanted, install the debug flavor instead
           (vcpkg install with triplet x86-windows and no binary caching, which
           rebuilds every port from source and populates debug\lib\), then put
           MultiThreadedDebugDLL back. -->
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <!-- _DEBUG is deliberately absent.
           It has to go with MultiThreadedDebugDLL: when _DEBUG is defined the
           CRT headers compile their assertions into calls to __CrtDbgReport,
           which lives only in the debug CRT. Defining _DEBUG while linking the
           release CRT produced 22 unresolved __imp___CrtDbgReport symbols.
           The configuration is otherwise unchanged: no optimisation, and the
           rest of the debug settings still apply. -->
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- vcpkg's x86-windows debug ports rename these five; the rest keep the
           release name. Listing the release names unconditionally makes Debug
           fail at LNK1104. -->
      <AdditionalDependencies>libpng16d.lib;zd.lib;freetyped.lib;bz2d.lib;fmtd.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>libpng16.lib;z.lib;freetype.lib;bz2.lib;fmt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
