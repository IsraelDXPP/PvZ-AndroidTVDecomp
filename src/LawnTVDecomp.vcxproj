  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
  <!-- Stage the game's assets beside the executable.

       The Android build reads assets through the platform asset manager, which
       is rooted at a fixed directory regardless of the working directory. The
       desktop equivalent is that same tree beside the exe, laid out flat: the
       game opens "properties/resources.xml" relative to the working
       directory, so an assets/ level would not be found.

       The copy is incremental: it only runs when the staged tree is missing or
       older than the source, so it costs nothing on a normal rebuild. Run
       tools\stage-assets.ps1 once to populate the source tree. -->
  <Target Name="StageAssets" AfterTargets="Build" Condition="Exists('$(RepoRoot)assets')">
    <ItemGroup>
      <_AssetFiles Include="$(RepoRoot)assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetFiles)" DestinationFiles="@(_AssetFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_AssetFiles)' != ''" />
    <Message Importance="normal" Text="Staged @(_AssetFiles-&gt;Count()) asset file(s) to $(OutDir)" Condition="'@(_AssetFiles)' != ''" />
  </Target>
</Project>