{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": "base",
            "environment": {
                "VSLANG": "1033"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "macos",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "android",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_PLATFORM": "android-28",
                "ANDROID_STL": "c++_shared",
                "CMAKE_POSITION_INDEPENDENT_CODE": true
            }
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 debug",
            "inherits": [
                "windows",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 release",
            "inherits": [
                "windows",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "windows-x86-debug",
            "displayName": "Windows x86 debug",
            "inherits": [
                "windows",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x86-windows"
            },
            "architecture": {
                "value": "x86",
                "strategy": "external"
            }
        },
        {
            "name": "windows-x86-release",
            "displayName": "Windows x86 release",
            "inherits": [
                "windows",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x86-windows"
            },
            "architecture": {
                "value": "x86",
                "strategy": "external"
            }
        },
        {
            "name": "macos-arm64-debug",
            "displayName": "macOS Apple Silicon debug",
            "inherits": [
                "macos",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "macos-arm64-release",
            "displayName": "macOS Apple Silicon release",
            "inherits": [
                "macos",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "macos-x64-debug",
            "displayName": "macOS Intel debug",
            "inherits": [
                "macos",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-osx",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            }
        },
        {
            "name": "macos-x64-release",
            "displayName": "macOS Intel release",
            "inherits": [
                "macos",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-osx",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            }
        },
        {
            "name": "linux-x64-debug",
            "displayName": "Linux x64 debug",
            "inherits": [
                "linux",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 release",
            "inherits": [
                "linux",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "linux-arm64-debug",
            "displayName": "Linux arm64 (native) debug",
            "inherits": [
                "linux",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-linux"
            }
        },
        {
            "name": "linux-arm64-release",
            "displayName": "Linux arm64 (native) release",
            "inherits": [
                "linux",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-linux"
            }
        },
        {
            "name": "android-arm64-debug",
            "displayName": "Android arm64-v8a shared library debug",
            "inherits": [
                "android",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "lawn-arm64-android",
                "ANDROID_ABI": "arm64-v8a"
            }
        },
        {
            "name": "android-arm64-release",
            "displayName": "Android arm64-v8a shared library release",
            "inherits": [
                "android",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "lawn-arm64-android",
                "ANDROID_ABI": "arm64-v8a"
            }
        },
        {
            "name": "android-armv7-debug",
            "displayName": "Android armeabi-v7a shared library debug",
            "inherits": [
                "android",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "lawn-armv7-android",
                "ANDROID_ABI": "armeabi-v7a",
                "ANDROID_ARM_NEON": true
            }
        },
        {
            "name": "android-armv7-release",
            "displayName": "Android armeabi-v7a shared library release",
            "inherits": [
                "android",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "lawn-armv7-android",
                "ANDROID_ABI": "armeabi-v7a",
                "ANDROID_ARM_NEON": true
            }
        },
        {
            "name": "android-x64-debug",
            "displayName": "Android x86_64 emulator shared library debug",
            "inherits": [
                "android",
                "debug"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "lawn-x64-android",
                "ANDROID_ABI": "x86_64"
            }
        },
        {
            "name": "android-x64-release",
            "displayName": "Android x86_64 emulator shared library release",
            "inherits": [
                "android",
                "release"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "lawn-x64-android",
                "ANDROID_ABI": "x86_64"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug"
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release"
        },
        {
            "name": "windows-x86-debug",
            "configurePreset": "windows-x86-debug"
        },
        {
            "name": "windows-x86-release",
            "configurePreset": "windows-x86-release"
        },
        {
            "name": "macos-arm64-debug",
            "configurePreset": "macos-arm64-debug"
        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release"
        },
        {
            "name": "macos-x64-debug",
            "configurePreset": "macos-x64-debug"
        },
        {
            "name": "macos-x64-release",
            "configurePreset": "macos-x64-release"
        },
        {
            "name": "linux-x64-debug",
            "configurePreset": "linux-x64-debug"
        },
        {
            "name": "linux-x64-release",
            "configurePreset": "linux-x64-release"
        },
        {
            "name": "linux-arm64-debug",
            "configurePreset": "linux-arm64-debug"
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64-release"
        },
        {
            "name": "android-arm64-debug",
            "configurePreset": "android-arm64-debug"
        },
        {
            "name": "android-arm64-release",
            "configurePreset": "android-arm64-release"
        },
        {
            "name": "android-armv7-debug",
            "configurePreset": "android-armv7-debug"
        },
        {
            "name": "android-armv7-release",
            "configurePreset": "android-armv7-release"
        },
        {
            "name": "android-x64-debug",
            "configurePreset": "android-x64-debug"
        },
        {
            "name": "android-x64-release",
            "configurePreset": "android-x64-release"
        }
    ]
}
